# =============================================================================
# Internship Management System — environment template
# Copy to backend/.env and apps/mobile/.env. NEVER commit the filled-in files.
# Reference: docs/10_Project_Setup_README.md §2
# =============================================================================

# ---------------------------------------------------------------------------
# BACKEND (backend/.env) — Supabase Postgres
# 08_Implementation_Plan Phase 0 recommends Supabase for both database and
# object storage, so both live in one project.
# ---------------------------------------------------------------------------

# Pooled connection (Supavisor, port 6543) for app runtime.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (port 5432) for `prisma migrate` only.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-32-byte-base64-secret-value-000
AUTH_ACCESS_TOKEN_EXPIRY=900          # 15 minutes, in seconds
AUTH_REFRESH_TOKEN_EXPIRY=2592000     # 30 days, in seconds
AUTH_ISSUER=ims
AUTH_AUDIENCE=ims-clients

# Password reset token TTL (seconds) — 07_Security_and_Privacy §5
AUTH_RESET_TOKEN_EXPIRY=3600
# Account lockout — 10 failed attempts / 15 min window
AUTH_MAX_LOGIN_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900

# Supabase API + Storage. Private bucket, no public URLs (07_Security_and_Privacy §4).
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Service-role key bypasses RLS. Server-side only — never ship this in the app.
SUPABASE_SERVICE_ROLE_KEY=

STORAGE_BUCKET=internship-documents
STORAGE_UPLOAD_URL_TTL=300            # 5 minutes  (03_TechSpec §6)
STORAGE_DOWNLOAD_URL_TTL=900          # 15 minutes (03_TechSpec §6)
MAX_UPLOAD_BYTES=10485760             # 10 MB      (02_SRS §3)

APP_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3001
INSTITUTION_NAME=Sri Manakula Vinayagar Engineering College

# IANA timezone deciding what "today" means for attendance and reminder schedules.
INSTITUTION_TIMEZONE=Asia/Kolkata

# Push notifications (Expo → FCM/APNs)
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# Rate limiting / cache. Falls back to in-process limiter when unset.
REDIS_URL=

# Scheduled-job authentication for reminder cron endpoints
CRON_SECRET=change-me

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# MOBILE (apps/mobile/.env) — public values only, bundled into the app
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_APP_ENV=development
