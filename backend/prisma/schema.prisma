// Internship Management System — Prisma schema
//
// SCOPE
//
// The app has one loop:
//
//   1. Faculty/admin configure a set of daily questions.
//   2. A student answers them for today and may attach files.
//   3. That submission *is* the attendance record for the day.
//   4. Faculty/admin review the answers and files, then approve or decline.
//
// Everything else has been removed. There is no mentor role, no internship or
// organisation records, no separate attendance/work-log tables, no weekly reports,
// no final assessment, no notifications and no export jobs.
//
// Attendance is not its own table on purpose: a day is "attended" when an approved
// DailySubmission exists for it, so there is one row per student per day and no way
// for the two to disagree.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Supabase-hosted Postgres.
  //
  // `url` is the pooled connection (Supavisor). Serverless route handlers open and
  // drop connections constantly, and the pooler keeps that from exhausting the
  // database's connection limit.
  //
  // `directUrl` is the direct connection. Prisma Migrate needs it because DDL,
  // advisory locks and the shadow database do not work through a transaction-mode
  // pooler.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Enums
// =============================================================================

/// `admin` is faculty with institution-wide scope rather than a separate feature
/// set, so every faculty capability check accepts both.
enum UserRole {
  student
  faculty
  admin
}

enum UserStatus {
  active
  suspended
  pending
}

enum ClientPlatform {
  ios
  android
  web
}

/// The review state of a day's submission. `pending` is the state a student's
/// submission lands in; only faculty move it out.
enum SubmissionStatus {
  pending
  approved
  declined
}

/// Free text is the default. `number` and `choice` exist so a question can be
/// validated more tightly without needing a schema change per question.
enum QuestionType {
  text
  long_text
  number
  choice
  file_upload
}

// =============================================================================
// Users and institution
// =============================================================================

model User {
  id String @id @default(uuid()) @db.Uuid

  /// Links to Supabase auth.users.id. This is how we find the app record after
  /// validating the Supabase JWT. Unique so one auth account = one app user.
  authId String     @unique @map("auth_id")
  email  String     @unique
  role   UserRole
  status UserStatus @default(active)

  /// Display name for faculty and admin accounts. A student's name lives on the
  /// student record.
  name String?

  /// The department a faculty member or admin belongs to. Null means
  /// institution-wide, which is the normal case for an admin.
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student   Student?
  documents Document[]
  auditLogs AuditLog[]

  authoredQuestions  Question[]        @relation("QuestionAuthor")
  reviewedSubmissions DailySubmission[] @relation("SubmissionReviewer")

  @@index([authId])
  @@index([role, status])
  @@map("users")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  institution String   @default("Sri Manakula Vinayagar Engineering College")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  students Student[]
  /// Faculty and admin members assigned to this department.
  staff User[]

  @@unique([name, institution])
  @@map("departments")
}

model Student {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The master key for a student record. Stored uppercase.
  registerNumber String @unique @map("register_number")
  name           String
  programme      String

  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// CHECK (year BETWEEN 1 AND 5) — added by migration.
  year         Int?
  section      String?
  studentEmail String  @map("student_email")
  mobile       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  submissions DailySubmission[]

  @@index([registerNumber])
  @@index([departmentId])
  @@map("students")
}

// =============================================================================
// Questions
// =============================================================================

/// A question students answer each day.
///
/// Questions are soft-retired with `isActive` rather than deleted, because a past
/// submission's answers still reference them and the history has to stay readable.
model Question {
  id String @id @default(uuid()) @db.Uuid

  prompt   String
  helpText String?      @map("help_text")
  type     QuestionType @default(long_text)

  /// Display order on the form. Ties break by createdAt.
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")
  required  Boolean @default(true)

  /// Only meaningful for `choice`. Stored as a JSON array of strings.
  options Json?

  /// Character bounds for text answers, enforced by the shared validators.
  minLength Int? @map("min_length")
  maxLength Int? @map("max_length")

  /// Scopes a question to one department. Null means it applies to everyone.
  departmentId String? @map("department_id") @db.Uuid

  /// An optional reference file attached to the question (e.g. a PDF that students
  /// should read before answering). Nullable — most questions are text-only.
  referenceDocId String?   @unique @map("reference_doc_id") @db.Uuid
  referenceDoc   Document? @relation(fields: [referenceDocId], references: [id], onDelete: SetNull)

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  answers Answer[]

  @@index([isActive, sortOrder])
  @@index([departmentId])
  @@map("questions")
}

// =============================================================================
// Daily submissions — the attendance record
// =============================================================================

/// One row per student per day. Its existence means the student answered; an
/// `approved` status means the day counts as attended.
model DailySubmission {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// The day being answered for, in the institution's timezone. DATE, not
  /// timestamp, so "which day" is never a timezone question.
  submissionDate DateTime @map("submission_date") @db.Date

  status SubmissionStatus @default(pending)

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  /// Set together when a reviewer acts. `reviewNote` carries the decline reason,
  /// which the student is shown so they know what to fix.
  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedBy   User?     @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote   String?   @map("review_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  answers   Answer[]
  documents Document[]

  /// One submission per student per day. This is what makes a double submission
  /// impossible rather than merely unlikely.
  @@unique([studentId, submissionDate])
  @@index([status, submissionDate])
  @@index([studentId, submissionDate])
  @@map("daily_submissions")
}

model Answer {
  id String @id @default(uuid()) @db.Uuid

  submissionId String          @map("submission_id") @db.Uuid
  submission   DailySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String   @map("question_id") @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// The question prompt as it read when answered. Denormalised on purpose: an
  /// edited or retired question must not silently rewrite past history.
  promptSnapshot String @map("prompt_snapshot")

  answerText String @map("answer_text")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// One answer per question per submission.
  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@map("answers")
}

// =============================================================================
// Documents
// =============================================================================

/// A file a student attached to a day's submission.
///
/// There is no per-document review state: a document is reviewed as part of its
/// submission, so approving the submission approves everything in it. That removes
/// the possibility of a submission being approved while a file inside it is not.
model Document {
  id String @id @default(uuid()) @db.Uuid

  ownerUserId String @map("owner_user_id") @db.Uuid
  ownerUser   User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  /// Nullable so an upload URL can be issued before the submission row exists;
  /// `POST /api/documents/complete` attaches it.
  submissionId String?          @map("submission_id") @db.Uuid
  submission   DailySubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// Random UUID path, never derived from the filename or student id. Server-only:
  /// excluded from every API response.
  storageKey String @unique @map("storage_key")

  originalFilename String @map("original_filename")
  mimeType         String @map("mime_type")
  sizeBytes        Int    @map("size_bytes")
  /// SHA-256 for integrity.
  checksum String?

  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  /// Soft delete: the row is marked first and the storage object is removed
  /// afterwards, so a failed storage call cannot orphan a live row.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  /// Reverse relation: when this document is a reference file on a question.
  question Question?

  @@index([ownerUserId])
  @@index([submissionId])
  @@map("documents")
}

// =============================================================================
// Audit
// =============================================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Nullable: a failed login has no authenticated actor yet.
  actorUserId String? @map("actor_user_id") @db.Uuid
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid

  clientPlatform ClientPlatform? @map("client_platform")
  clientVersion  String?         @map("client_version")
  ipAddress      String?         @map("ip_address") @db.Inet

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}
