# =============================================================================
# Mobile app environment — copy to apps/mobile/.env
#
#     cp .env.example .env
#
# Public values only. Everything with the EXPO_PUBLIC_ prefix is inlined into the
# JavaScript bundle by Metro and is readable by anyone with the APK, so no secret
# belongs in this file. Backend-only values live in backend/.env; see the template
# at the repository root.
#
# WHY THIS FILE EXISTS
#
# `.env` is gitignored, and inlining happens at bundle time rather than at launch.
# A build made without it therefore compiles `undefined` in place of every value
# below and cannot be corrected without rebuilding. That used to be silent: the API
# client fell back to http://localhost:3000/api, which on a phone is the phone
# itself, so every request failed looking like a bad connection rather than a bad
# build. Requests now fail with a message that names this file instead.
#
# Restart Metro with --clear after editing; the previous values are cached.
# =============================================================================

# Base URL of the backend, including the /api suffix.
#   local development : http://localhost:3000/api
#   Android emulator  : http://10.0.2.2:3000/api   (localhost is the emulator itself)
#   physical device   : http://<your-lan-ip>:3000/api
#   deployed          : https://internship-app-backend.vercel.app/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# `development` or `production`. Only affects app-level behaviour, not the build type.
EXPO_PUBLIC_APP_ENV=development

# Supabase project used for authentication. Required — the client throws on startup
# without both of these. The anon key is meant to be public and is constrained by
# row-level security; the service-role key is not, and must stay on the server.
EXPO_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
