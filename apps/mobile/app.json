{
  "expo": {
    "name": "Internship Manager",
    "slug": "internship-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_logo.png",
    "scheme": "internshipmanager",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5f6fa",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#414fb8"
    },
    "ios": {
      "bundleIdentifier": "edu.smvec.internship",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "edu.smvec.internship",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#414fb8"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/app_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "flipper": false
          },
          "android": {
            "usesCleartextTraffic": false,
            "useLegacyPackaging": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86",
              "x86_64"
            ]
          }
        }
      ],
      [
        "./plugins/with-android-abi-splits",
        {
          "universalApk": false
        }
      ],
      "./plugins/with-android-release-signing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
